# 仅将这些变量合并到入库适配器的 bridge.env，不是 BiliNote 的 .env。
# 保留已有 ARCHIVE_BRIDGE_TOKEN、ARCHIVE_QQ_TARGET、Vault 和 Hermes 路径配置。
ARCHIVE_NOTIFY_TRANSPORT=webhook
ARCHIVE_HERMES_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/bilinote-archive
# 在服务器填写随机密钥，与 Hermes 路由 secret 完全一致；空值会阻止启动。
ARCHIVE_HERMES_WEBHOOK_SECRET=
